<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Module4Lab</title>
    <!-- Bootstrap is a free CSS framework that gives us nice-looking
         buttons, cards, and lists without writing our own CSS. This is
         already wired up for you, so you can jump straight into C#. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <main role="main" class="pb-3">
            <!-- @RenderBody() is where the content of each individual
                 page (like Index.cshtml) gets inserted into this shared
                 layout. -->
            @RenderBody()
        </main>
    </div>
</body>
</html>
